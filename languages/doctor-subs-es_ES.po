#. translators: 1: first name, 2: count, 3: window days
#, php-format
msgid ""
"%1$s's renewal has failed %2$d times in the last %3$d days. Often a gateway "
"blip that clears on retry, but worth another look if this retry fails too."
msgstr ""
"La renovación de %1$s ha fallado %2$d veces en los últimos %3$d días. A "
"menudo es un fallo temporal del gateway que se resuelve con un reintento, "
"pero vale la pena echar otro vistazo si este reintento también falla."

